{
  "name": "parrainage",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "postinstall": "npm run build -w @parrainage/contracts",
    "dev": "npm run build -w @parrainage/contracts && concurrently -n contracts,api,web -c gray,green,blue \"npm run dev -w @parrainage/contracts\" \"npm run dev -w @parrainage/api\" \"npm run dev -w @parrainage/web\"",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build",
    "db:migrate": "npm run db:migrate -w @parrainage/api",
    "db:seed": "npm run db:seed -w @parrainage/api",
    "db:reset": "npm run db:reset -w @parrainage/api",
    "db:studio": "npm run db:studio -w @parrainage/api",
    "simulate:payments": "npm run simulate:payments -w @parrainage/api"
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1"
  }
}
