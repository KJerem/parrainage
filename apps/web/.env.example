# Adresse publique de l'application (le navigateur ne parle qu'à cette origine)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Adresse interne de l'API NestJS (utilisée par les réécritures /api/* et les appels serveur)
API_INTERNAL_URL=http://localhost:4000

# Origine publique du stockage des médias (S3_PUBLIC_ENDPOINT de l'API), autorisée par la CSP
S3_PUBLIC_ENDPOINT=http://localhost:9000

# Taille d'une page de « Tout le fil » (1 à 50, 20 par défaut ; les tests E2E la fixent à 1)
# FEED_PAGE_SIZE=20
