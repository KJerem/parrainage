# API NestJS (http://localhost:4000, exposée au navigateur via les réécritures /api/* du web)
PORT=4000
APP_URL=http://localhost:3000

# Base de données (docker compose expose PostgreSQL sur 5433)
DATABASE_URL=postgresql://parrainage:parrainage@localhost:5433/parrainage?schema=public

# Stockage S3 (RustFS)
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=media
S3_ACCESS_KEY=devaccess
S3_SECRET_KEY=devsecret123

# E-mails (Mailpit : interface sur http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM="Parrainage LRT <no-reply@parrainage.local>"

# Authentification (Better Auth) : APP_URL ci-dessus sert d'origine (liens magiques, redirections).
# Secret d'au moins 32 caractères, par exemple : openssl rand -base64 32
BETTER_AUTH_SECRET=dev-uniquement-remplacer-par-un-secret-aleatoire

# Seed de démonstration (développement uniquement)
# SEED_TODAY=2026-10-31
SEED_DEFAULT_PASSWORD=motdepasse
