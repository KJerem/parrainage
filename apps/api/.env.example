# API NestJS (http://localhost:4000, exposée au navigateur via les réécritures /api/* du web)
PORT=4000
APP_URL=http://localhost:3000

# Base de données (docker compose expose PostgreSQL sur 5433)
DATABASE_URL=postgresql://parrainage:parrainage@localhost:5433/parrainage?schema=public

# Stockage S3 (RustFS)
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=media
S3_ACCESS_KEY=devaccess
S3_SECRET_KEY=devsecret123

# Fichiers joints aux messages : plafonds en Mo et durée maximale d'une vidéo (secondes).
# Le navigateur dépose les fichiers directement dans le stockage : S3_PUBLIC_ENDPOINT doit
# autoriser l'origine du web en CORS (S3_CORS_ORIGINS du .env racine, lu par docker compose).
UPLOAD_MAX_PHOTO_MB=10
UPLOAD_MAX_VIDEO_MB=25
UPLOAD_MAX_DOC_MB=10
VIDEO_MAX_SECONDS=120

# Messages et encouragements par utilisateur sur une fenêtre glissante (au-delà : 429).
MESSAGE_RATE_LIMIT_MAX=20
MESSAGE_RATE_LIMIT_WINDOW_SECONDS=600

# E-mails (Mailpit : interface sur http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM="Parrainage LRT <no-reply@parrainage.local>"

# Authentification (Better Auth) : APP_URL ci-dessus sert d'origine (liens magiques, redirections).
# Secret d'au moins 32 caractères, par exemple : openssl rand -base64 32
BETTER_AUTH_SECRET=dev-uniquement-remplacer-par-un-secret-aleatoire

# Horloge figée (démo, e2e) : l'application calcule ses dates à partir de cet instant ISO 8601.
# Absente : heure réelle. Avec SEED_TODAY=2026-10-31, l'écran parrain reproduit la maquette.
# APP_NOW=2026-10-31T10:00:00Z

# Seed de démonstration (développement uniquement). Sans SEED_TODAY : jour d'APP_NOW, sinon
# aujourd'hui.
# SEED_TODAY=2026-10-31
SEED_DEFAULT_PASSWORD=motdepasse

# Poivre du code image des enfants (32 caractères au moins) : à changer en production, où la valeur
# d'exemple est refusée. Sans cette variable, le développement utilise une valeur par défaut.
CHILD_CODE_PEPPER=dev-uniquement-poivre-du-code-image-des-enfants

# Sessions élèves : signature des cookies (32 caractères au moins, à changer en production,
# où la valeur d'exemple est refusée), échecs avant le verrou d'un enfant et avant la suspension
# de la session, durée maximale d'une vidéo d'enfant.
CHILD_SESSION_SECRET=dev-uniquement-secret-des-sessions-eleves-a-changer
CHILD_CODE_MAX_ATTEMPTS=3
CHILD_SESSION_MAX_FAILURES=15
CHILD_VIDEO_MAX_SECONDS=60

# Tâches planifiées : publication des nouvelles programmées (chaque minute) et purge des fichiers
# sans usage (chaque heure). « false » les coupe (tests, instance secondaire).
SCHEDULER_ENABLED=true
