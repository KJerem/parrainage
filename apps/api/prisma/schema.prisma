generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// Conventions : montants en centimes (Int), dates civiles en @db.Date (minuit UTC),
// teintes d'avatar validées par `avatarToneSchema` (@parrainage/contracts).

/// Réglages applicatifs modifiables par le bureau (taux, mentions du reçu, numérotation…).
model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// ─── Better Auth ──────────────────────────────────────────────────────────────
// Modèles générés par `npx auth@1.7.14 generate` (la CLI réécrit ce fichier : fusionner à la main).
// Les relations vers les modèles métier sont ajoutées en fin de modèle User.

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  role          String?
  banned        Boolean?  @default(false)
  banReason     String?
  banExpires    DateTime?
  sessions      Session[]
  accounts      Account[]

  // Relations métier (hors Better Auth).
  relais           Relais?
  parrainProfile   ParrainProfile?
  createdChildren  Child[]                   @relation("ChildCreatedBy")
  auditLogs        AuditLog[]
  uploadedMedia    Media[]                   @relation("MediaUploadedBy")
  newsPosts        NewsPost[]                @relation("NewsPostAuthor")
  conversations    ConversationParticipant[]
  messages         Message[]                 @relation("MessageAuthor")
  reviewedMessages Message[]                 @relation("MessageReviewer")
  enteredResults   SchoolResult[]            @relation("SchoolResultEnteredBy")
  recordedConsents ConsentRecord[]           @relation("ConsentRecordedBy")

  @@unique([email])
  @@map("user")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

/// Compteurs de tentatives : Better Auth (clés « ip|chemin ») et limites par e-mail (« email:… »).
model RateLimit {
  id          String @id
  key         String
  count       Int
  lastRequest BigInt

  @@unique([key])
  @@map("rateLimit")
}

// ─── Réseau ───────────────────────────────────────────────────────────────────

enum Gender {
  F
  M
}

enum SchoolLevel {
  PRIMAIRE
  COLLEGE
  LYCEE
}

enum ChildFileStatus {
  DRAFT
  SUBMITTED
  VALIDATED
  ARCHIVED
}

/// Relais local de l'association (un compte de rôle « relais »).
model Relais {
  id             String    @id @default(cuid())
  userId         String    @unique
  user           User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  displayName    String
  city           String
  district       String
  country        String    @default("Togo")
  timeZone       String    @default("Africa/Lome")
  lastActivityAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  schools       School[]
  children      Child[]
  newsPosts     NewsPost[]
  conversations Conversation[]
}

model School {
  id        String      @id @default(cuid())
  relaisId  String
  relais    Relais      @relation(fields: [relaisId], references: [id], onDelete: Restrict)
  shortName String
  fullName  String
  city      String
  level     SchoolLevel
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  children Child[]

  @@unique([relaisId, shortName])
}

/// Profil d'un parrain ou d'une marraine (un compte de rôle « parrain »).
model ParrainProfile {
  id           String    @id @default(cuid())
  userId       String    @unique
  user         User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  firstName    String
  /// Initiale du nom, sans point (« M » pour « Claire M. »).
  lastInitial  String
  displayName  String
  gender       Gender
  city         String
  country      String    @default("France")
  timeZone     String    @default("Europe/Paris")
  /// Adresse postale, pour le reçu fiscal.
  addressLine  String?
  postalCode   String?
  wishes       String?
  avatarTone   String    @default("info")
  /// Jour du prélèvement mensuel simulé (1 à 28).
  debitDay     Int       @default(5)
  joinedAt     DateTime  @default(now())
  lastActiveAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  sponsorships  Sponsorship[]
  conversations Conversation[]
  payments      Payment[]
}

model Child {
  id                 String          @id @default(cuid())
  relaisId           String
  relais             Relais          @relation(fields: [relaisId], references: [id], onDelete: Restrict)
  schoolId           String?
  school             School?         @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  firstName          String
  lastInitial        String
  gender             Gender
  /// Jamais transmise au parrain (seul l'âge est affiché).
  birthDate          DateTime        @db.Date
  district           String
  className          String
  /// Année scolaire, « 2026-2027 ».
  schoolYear         String
  teacherName        String?
  avatarTone         String          @default("amber")
  guardianName       String
  /// Jamais transmis au parrain.
  guardianPhone      String
  consentSponsorship Boolean         @default(false)
  consentMedia       Boolean         @default(false)
  fileStatus         ChildFileStatus @default(DRAFT)
  createdById        String
  createdBy          User            @relation("ChildCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  /// Photo de profil (média AVATAR) : jamais montrée au parrain sans `consentMedia`.
  photoMediaId       String?         @unique
  photo              Media?          @relation("ChildPhoto", fields: [photoMediaId], references: [id], onDelete: SetNull)
  /// Autorisation signée par le responsable : relais et bureau seulement.
  consentDocumentId  String?         @unique
  consentDocument    Media?          @relation("ChildConsentDocument", fields: [consentDocumentId], references: [id], onDelete: SetNull)
  /// Code image haché (Argon2id, poivre CHILD_CODE_PEPPER) : montré une seule fois au relais.
  codeHash           String?
  codeSetAt          DateTime?
  submittedAt        DateTime?
  validatedAt        DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  sponsorships  Sponsorship[]
  newsPosts     NewsPostChild[]
  conversations Conversation[]
  participants  ConversationParticipant[]
  messages      Message[]                 @relation("MessageAuthorChild")
  results       SchoolResult[]
  payments      Payment[]
  consents      ConsentRecord[]

  @@index([relaisId, fileStatus])
  @@index([schoolId])
  @@index([createdById])
}

enum ConsentType {
  SPONSORSHIP
  MEDIA
}

/// Trace d'un accord du responsable légal : le texte accepté, sa date, qui l'a recueilli, son retrait.
model ConsentRecord {
  id           String      @id @default(cuid())
  childId      String
  child        Child       @relation(fields: [childId], references: [id], onDelete: Cascade)
  type         ConsentType
  /// Version du texte présenté au responsable.
  textVersion  String
  recordedById String?
  recordedBy   User?       @relation("ConsentRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)
  grantedAt    DateTime
  withdrawnAt  DateTime?
  createdAt    DateTime    @default(now())

  @@index([childId, type])
  @@index([recordedById])
}

// ─── Binômes ──────────────────────────────────────────────────────────────────

enum SponsorshipStatus {
  ACTIVE
  PAUSED
  ENDED
}

/// Binôme parrain ↔ enfant. Le co-parrainage est permis ; la santé du binôme est calculée.
model Sponsorship {
  id                 String            @id @default(cuid())
  childId            String
  child              Child             @relation(fields: [childId], references: [id], onDelete: Restrict)
  parrainId          String
  parrain            ParrainProfile    @relation(fields: [parrainId], references: [id], onDelete: Restrict)
  status             SponsorshipStatus @default(ACTIVE)
  monthlyAmountCents Int
  startDate          DateTime          @db.Date
  endDate            DateTime?         @db.Date
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  conversation Conversation?
  payments     Payment[]

  @@index([childId, status])
  @@index([parrainId, status])
}

// ─── Médias ───────────────────────────────────────────────────────────────────

enum MediaKind {
  PHOTO
  VIDEO
  BULLETIN
  DOCUMENT
  CONSENT
  RECEIPT
  AVATAR
}

enum MediaStatus {
  PENDING_UPLOAD
  READY
  REJECTED
  /// Média de démonstration sans fichier : affiché comme un emplacement réservé.
  PLACEHOLDER
}

/// Fichier du stockage S3, servi uniquement par GET /api/media/:id (URL présignée de 120 s).
model Media {
  id               String        @id @default(cuid())
  kind             MediaKind
  status           MediaStatus   @default(PENDING_UPLOAD)
  storageKey       String?       @unique
  /// Envoi multipart S3 en cours (fichier de plus de 5 Mo) ; effacé une fois le fichier assemblé.
  uploadId         String?
  posterKey        String?
  mimeType         String
  sizeBytes        Int?
  width            Int?
  height           Int?
  durationSec      Int?
  label            String?
  uploadedByUserId String?
  uploadedBy       User?         @relation("MediaUploadedBy", fields: [uploadedByUserId], references: [id], onDelete: SetNull)
  messageId        String?
  message          Message?      @relation(fields: [messageId], references: [id], onDelete: SetNull)
  newsPostId       String?
  newsPost         NewsPost?     @relation(fields: [newsPostId], references: [id], onDelete: SetNull)
  schoolResultId   String?
  schoolResult     SchoolResult? @relation(fields: [schoolResultId], references: [id], onDelete: SetNull)
  /// Ordre d'affichage parmi les médias d'un même contenu.
  position         Int           @default(0)
  createdAt        DateTime      @default(now())

  avatarOf  Child? @relation("ChildPhoto")
  consentOf Child? @relation("ChildConsentDocument")

  @@index([messageId])
  @@index([newsPostId])
  @@index([schoolResultId])
  @@index([uploadedByUserId])
  @@index([status, createdAt])
}

// ─── Contenus ─────────────────────────────────────────────────────────────────

enum NewsPostType {
  ONE_CHILD
  SEVERAL_CHILDREN
  RELAIS_LIFE
}

enum NewsPostStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
}

/// Poste d'où un contenu a été envoyé.
enum SentFrom {
  WEB
  MOBILE
  SCHOOL_SESSION
}

/// Nouvelle publiée par un relais pour un ou plusieurs enfants (ou sur la vie du relais).
model NewsPost {
  id                String         @id @default(cuid())
  relaisId          String
  relais            Relais         @relation(fields: [relaisId], references: [id], onDelete: Restrict)
  authorUserId      String?
  author            User?          @relation("NewsPostAuthor", fields: [authorUserId], references: [id], onDelete: SetNull)
  type              NewsPostType
  status            NewsPostStatus @default(DRAFT)
  title             String
  body              String
  notifyParrains    Boolean        @default(true)
  notifyBureau      Boolean        @default(false)
  visibleToChildren Boolean        @default(false)
  scheduledAt       DateTime?
  publishedAt       DateTime?
  sentFrom          SentFrom       @default(WEB)
  idempotencyKey    String?        @unique
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  children NewsPostChild[]
  media    Media[]

  @@index([relaisId, status, publishedAt])
  @@index([status, scheduledAt])
}

model NewsPostChild {
  newsPostId String
  newsPost   NewsPost @relation(fields: [newsPostId], references: [id], onDelete: Cascade)
  childId    String
  child      Child    @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@id([newsPostId, childId])
  @@index([childId])
}

enum AcademicPeriodKind {
  T1
  T2
  T3
  ANNUAL
}

model AcademicPeriod {
  id         String             @id @default(cuid())
  /// Année scolaire, « 2026-2027 ».
  schoolYear String
  kind       AcademicPeriodKind
  /// Libellé court, placé après la classe : « 1er trimestre », « moyenne annuelle ».
  label      String
  /// Date limite de saisie des résultats par les relais.
  dueDate    DateTime?          @db.Date
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  results SchoolResult[]

  @@unique([schoolYear, kind])
}

enum SchoolResultStatus {
  TO_ENTER
  DRAFT
  SENT
}

/// Résultats d'un enfant pour une période ; moyenne en centièmes (13,4 / 20 → 1340).
model SchoolResult {
  id               String             @id @default(cuid())
  childId          String
  child            Child              @relation(fields: [childId], references: [id], onDelete: Restrict)
  periodId         String
  period           AcademicPeriod     @relation(fields: [periodId], references: [id], onDelete: Restrict)
  /// Classe pendant la période (l'enfant change de classe chaque année).
  className        String
  averageX100      Int?
  rank             Int?
  classSize        Int?
  appreciation     String?
  status           SchoolResultStatus @default(TO_ENTER)
  allowChildUpload Boolean            @default(false)
  enteredById      String?
  enteredBy        User?              @relation("SchoolResultEnteredBy", fields: [enteredById], references: [id], onDelete: SetNull)
  sentAt           DateTime?
  /// Horodatage du poste (saisie hors ligne) : une donnée plus ancienne est refusée (409).
  clientUpdatedAt  DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  media Media[]

  @@unique([childId, periodId])
  @@index([periodId, status])
}

// ─── Messagerie ───────────────────────────────────────────────────────────────

enum ConversationKind {
  SPONSORSHIP
  PARRAIN_RELAIS
  RELAIS_BUREAU
  PARRAIN_BUREAU
  CHILD_ASSOCIATION
}

/// Une seule conversation par binôme (SPONSORSHIP) : un co-parrain ne voit pas celle de l'autre.
model Conversation {
  id            String           @id @default(cuid())
  kind          ConversationKind
  sponsorshipId String?          @unique
  sponsorship   Sponsorship?     @relation(fields: [sponsorshipId], references: [id], onDelete: Restrict)
  childId       String?
  child         Child?           @relation(fields: [childId], references: [id], onDelete: Restrict)
  relaisId      String?
  relais        Relais?          @relation(fields: [relaisId], references: [id], onDelete: Restrict)
  parrainId     String?
  parrain       ParrainProfile?  @relation(fields: [parrainId], references: [id], onDelete: Restrict)
  subject       String?
  lastMessageAt DateTime         @default(now())
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  participants ConversationParticipant[]
  messages     Message[]

  @@index([kind, lastMessageAt])
  @@index([childId])
  @@index([relaisId, lastMessageAt])
  @@index([parrainId, lastMessageAt])
}

/// Participant : un adulte (userId) ou un enfant (childId), jamais les deux.
model ConversationParticipant {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String?
  user           User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  childId        String?
  child          Child?       @relation(fields: [childId], references: [id], onDelete: Cascade)
  lastReadAt     DateTime?
  createdAt      DateTime     @default(now())

  @@unique([conversationId, userId])
  @@unique([conversationId, childId])
  @@index([userId])
  @@index([childId])
}

enum MessageKind {
  TEXT
  ENCOURAGEMENT
  CALL_REQUEST
  CALL_SLOTS
  SYSTEM
  NEWSLETTER
}

enum ModerationStatus {
  NOT_REQUIRED
  PENDING
  APPROVED
  HELD
  MASKED
}

enum DeliveryStatus {
  SENT
  VERIFIED
  RECEIVED
}

/// Alertes du détecteur automatique (`detectAlerts` de @parrainage/contracts) : une suite de
/// chiffres ou un nombre écrit en lettres compte comme un téléphone (PHONE).
enum AlertType {
  PHONE
  EMAIL
  URL
  SOCIAL
  ADDRESS
  MONEY
  MEETING
}

/// Signalements posés à la main par le relais ou le bureau.
enum ManualFlag {
  OTHER_CHILD_FACE
  THIRD_PARTY_PHOTO
  INAPPROPRIATE_CONTENT
  DIRECT_CONTACT
  OTHER
}

/// Le destinataire ne voit que les messages APPROVED ou MASKED (texte : `redactedBody`).
model Message {
  id               String           @id @default(cuid())
  conversationId   String
  conversation     Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  kind             MessageKind      @default(TEXT)
  body             String
  redactedBody     String?
  moderationStatus ModerationStatus
  deliveryStatus   DeliveryStatus   @default(SENT)
  /// Alertes du détecteur, avec leurs positions dans le texte d'origine.
  autoAlerts       Json             @default("[]")
  alertTypes       AlertType[]      @default([])
  manualFlags      ManualFlag[]     @default([])
  reviewedById     String?
  reviewedBy       User?            @relation("MessageReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt       DateTime?
  autoApproved     Boolean          @default(false)
  moderationReason String?
  sentFrom         SentFrom         @default(WEB)
  readAt           DateTime?
  idempotencyKey   String?          @unique
  authorUserId     String?
  authorUser       User?            @relation("MessageAuthor", fields: [authorUserId], references: [id], onDelete: SetNull)
  authorChildId    String?
  authorChild      Child?           @relation("MessageAuthorChild", fields: [authorChildId], references: [id], onDelete: SetNull)
  createdAt        DateTime         @default(now())

  media Media[]

  @@index([conversationId, createdAt])
  @@index([moderationStatus, createdAt])
  @@index([authorUserId])
  @@index([authorChildId, createdAt])
  @@index([reviewedById])
}

// ─── Finances (simulées) ──────────────────────────────────────────────────────

enum PaymentKind {
  MONTHLY
  ONE_OFF
}

enum PaymentMethod {
  SEPA_DEBIT
  CARD
  TRANSFER
  CHEQUE
}

enum PaymentStatus {
  SCHEDULED
  RECEIVED
  LATE
  FAILED
  CANCELLED
}

/// Versement simulé. `periodKey` (AAAA-MM) n'est renseigné que pour une mensualité : un seul
/// prélèvement par binôme et par mois ; les dons ponctuels (NULL) restent libres.
model Payment {
  id            String         @id @default(cuid())
  parrainId     String
  parrain       ParrainProfile @relation(fields: [parrainId], references: [id], onDelete: Restrict)
  sponsorshipId String?
  sponsorship   Sponsorship?   @relation(fields: [sponsorshipId], references: [id], onDelete: Restrict)
  childId       String?
  child         Child?         @relation(fields: [childId], references: [id], onDelete: Restrict)
  kind          PaymentKind
  amountCents   Int
  method        PaymentMethod
  label         String?
  dueDate       DateTime       @db.Date
  paidAt        DateTime?
  status        PaymentStatus  @default(SCHEDULED)
  reference     String         @unique
  periodKey     String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@unique([sponsorshipId, periodKey])
  @@index([parrainId, dueDate])
  @@index([childId, dueDate])
  @@index([status, dueDate])
}

// ─── Transverse ───────────────────────────────────────────────────────────────

/// Journal d'audit (liste fermée d'actions, voir le plan §8).
model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  actor       User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  action      String
  entityType  String
  entityId    String
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorUserId])
  @@index([createdAt])
}
