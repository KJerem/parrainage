generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

/// Réglages applicatifs modifiables par le bureau (taux, mentions du reçu, numérotation…).
model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}
