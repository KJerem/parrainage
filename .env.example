# Variables lues par docker compose (services locaux).
# Copier ce fichier en .env ; les applications ont leurs propres fichiers :
#   apps/api/.env.example  et  apps/web/.env.example

# PostgreSQL exposé sur la machine (5433 pour éviter un PostgreSQL déjà présent sur 5432)
POSTGRES_PORT=5433

# Stockage S3 (RustFS) : console sur http://localhost:9001
S3_ACCESS_KEY=devaccess
S3_SECRET_KEY=devsecret123
S3_REGION=us-east-1
S3_BUCKET=media
S3_CORS_ORIGINS=http://localhost:3000
